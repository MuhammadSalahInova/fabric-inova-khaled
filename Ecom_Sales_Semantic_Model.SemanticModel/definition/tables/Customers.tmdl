	column 'Customer Segment' =
			
			VAR R = [R_Score]
			VAR F = [F_Score]
			VAR M = [M_Score]
			RETURN
			SWITCH(
			    TRUE(),
			    R >= 4 && F >= 4 && M >= 4, "Champions",
			    R >= 3 && F >= 3, "Loyal Customers",
			    R >= 4 && F <= 2, "New Customers",
			    R <= 2 && F >= 3 && M >= 3, "At Risk",
			    R <= 2 && F <= 2 && M <= 2, "Lost",
			    "Potential Loyalist"
			)
		lineageTag: 0171107e-0fe4-4e53-be3a-ee33271984d2
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	partition Customers = entity
		mode: directLake
		source
			entityName: dim_customer
			schemaName: gold
			expressionSource: 'DirectLake - Ecom_Lakehouse'

	changedProperty = Name

	changedProperty = Description

