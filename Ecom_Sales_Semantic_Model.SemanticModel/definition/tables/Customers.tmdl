	/// Boolean indicator identifying whether the customer dimension record represents the current version of the customer. True means the record is the current version; False means it is a historical version.
	column IsCurrent
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 4537d321-7ee0-4091-a2e1-93dc1eda5094
