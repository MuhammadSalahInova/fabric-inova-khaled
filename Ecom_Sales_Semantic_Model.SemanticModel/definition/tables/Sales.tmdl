	/// Discount rate applied to the sales order line. The value is stored as a decimal between 0 and 1, where 0.15 represents a 15% discount. This field represents a rate and should not be summed as a total discount amount.
	column Discount
		dataType: double
		lineageTag: 1c218779-3208-435a-9a89-abac62aede87
		sourceLineageTag: Discount
		summarizeBy: sum
		sourceColumn: Discount

		changedProperty = Description

