/// Sales contains sales transactions at the order-line level. Each row represents one product sold within a customer order. This is the primary fact table for analyzing sales performance, revenue, quantities, discounts, freight, and orders. Gross Sales represents the sales amount before discounts. Discount Amount represents the monetary discount applied to the order line. Net Sales represents revenue after deducting the discount amount from Gross Sales. Quantity represents the number of units sold, while Unit Price represents the selling price per unit before discount. Customer Key, Product Key, Supplier Key, Employee Key, Shipper Key, and Date Key are surrogate keys used only to connect sales transactions to their corresponding dimension records and should not be treated as business identifiers. Order ID identifies the customer order, while Product ID identifies the product from the source business system. Discount Rate is stored as a decimal where 0.15 represents a 15% discount. Use Net Sales for revenue and sales performance analysis unless the user explicitly asks for Gross Sales.
table Sales
	lineageTag: 627dcfa1-f097-42a9-9239-fe92e30c1084
	sourceLineageTag: [gold].[fact_sales]

	measure 'Total Sales' =
			
			SUMX(
			    Sales,
			    Sales[Quantity] * [UnitPrice]
			)
		lineageTag: 9fbe9dfd-3331-467c-af1d-7725431726c9

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Technical surrogate key that uniquely identifies each row in the Sales fact table. It is used for internal data warehouse identification and relationships and should not be used as a business identifier or for business analysis.
	column FactSalesKey
		dataType: int64
		formatString: 0
		lineageTag: 992c5903-32e5-4781-9c41-48f68021fece
		sourceLineageTag: FactSalesKey
		summarizeBy: count
		sourceColumn: FactSalesKey

		changedProperty = Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the customer order from the source system. Multiple Sales rows can have the same Order ID because an order can contain multiple products. Use Order ID to identify and count distinct customer orders, not individual sales lines.
	column OrderID
		dataType: int64
		formatString: 0
		lineageTag: 0a835364-e5a6-4853-9db3-52760e3f83d2
		sourceLineageTag: OrderID
		summarizeBy: count
		sourceColumn: OrderID

		changedProperty = Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the product sold in the order line. It identifies the product from the source business system. Use Product ID or the related Products dimension to analyze sales by product.
	column ProductID
		dataType: int64
		formatString: 0
		lineageTag: caf0b6a4-cde4-491f-821f-032baa6c8b28
		sourceLineageTag: ProductID
		summarizeBy: count
		sourceColumn: ProductID

		changedProperty = Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Surrogate key used to connect the sales transaction to the corresponding customer record in the Customers dimension. This is a technical relationship key and should not be interpreted as the customer's business identifier. Use Customer ID or customer attributes for business analysis.
	column CustomerKey
		dataType: int64
		formatString: 0
		lineageTag: 39c67602-5024-418b-a958-665b66bc8911
