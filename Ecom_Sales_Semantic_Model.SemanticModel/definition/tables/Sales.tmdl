	column ProductKey
		dataType: int64
		formatString: 0
		lineageTag: 377fcdfc-23a3-4a10-8328-bd2fb2038161
		sourceLineageTag: ProductKey
		summarizeBy: none
		sourceColumn: ProductKey

		changedProperty = Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Surrogate key used to connect the sales transaction to the corresponding supplier record through the Products dimension. This is a technical relationship key and should not be interpreted as the supplier's business identifier.
	column SupplierKey
		dataType: int64
		formatString: 0
		lineageTag: b37362c6-3ee2-46c7-9969-5e7df40b32ad
